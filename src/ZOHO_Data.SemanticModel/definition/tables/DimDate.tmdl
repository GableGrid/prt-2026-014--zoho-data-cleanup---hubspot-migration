	partition DimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE(2019,1,1), DATE(2026,12,31) ),
				    "Year", YEAR([Date]),
				    "MonthNum", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMM YYYY"),
				    "Quarter", "Q" & QUARTER([Date])
				)

	annotation PBI_Id = c659bd511df44057b4e85bc36b824fea

