			defaultHierarchy: LocalDateTable_6b20dae4-1338-45ab-abdb-3da35c337b27.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: d426d268-7290-4388-a858-8a81d5284988
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column MonthNum
		formatString: 0
		lineageTag: 167fb887-7df7-4a16-baba-bc40cc561545
		summarizeBy: sum
		isNameInferred
