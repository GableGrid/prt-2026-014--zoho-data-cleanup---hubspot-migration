table DimDate
	lineageTag: e94982c9-0136-4f46-a09a-bface9219a45

	column Date
		formatString: General Date
		lineageTag: 2075f857-2086-46e5-902c-7b5edaf052c0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variation
			isDefault
