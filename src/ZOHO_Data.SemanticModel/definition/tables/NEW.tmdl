	measure 'Top1K Score' =
			
			CALCULATE(
			    AVERAGE(FileA_HubSpot_Import[lifetime_value]),
			    TOPN(
			        1000,
			        FileA_HubSpot_Import,
			        FileA_HubSpot_Import[lifetime_value],
			        DESC
			    )
			)
		lineageTag: ca44030e-226a-4f47-8f75-c3a7e4a90fdd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top1K Customers' =
			
