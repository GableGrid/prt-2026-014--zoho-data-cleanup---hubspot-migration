			    COUNTROWS(FileC_Scheduler_ApptHistory),
			    0
			)
		lineageTag: 25729db3-7cea-4c5a-b803-ba35e8d970ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Appts' = DIVIDE([Total Appts],[Total Contacts],0)
		lineageTag: 0a24a23e-d3c1-46af-9d16-22838534a43e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Appts by Month' =
