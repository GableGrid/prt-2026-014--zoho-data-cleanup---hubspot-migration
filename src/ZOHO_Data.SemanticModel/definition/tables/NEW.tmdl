	measure Completed =
			CALCULATE(COUNTROWS(FileC_Scheduler_ApptHistory),
			 FileC_Scheduler_ApptHistory[status]="Completed")
		formatString: 0
		lineageTag: 3ad1512f-0718-425f-ae0d-cb0cf70b71de

	measure 'No-Show Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(FileC_Scheduler_ApptHistory),
			        FileC_Scheduler_ApptHistory[status] = "No-Show"
