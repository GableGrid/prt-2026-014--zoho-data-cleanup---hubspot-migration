	measure 'Avg Archive Age' =
			
			AVERAGEX(
			    FileD_Archive,
			    DATEDIFF(
			        FileD_Archive[last_known_appointment],
			        TODAY(),
			        YEAR
			    )
			)
		lineageTag: bf70409c-0fc3-4d95-9734-e22cb2a548f3

