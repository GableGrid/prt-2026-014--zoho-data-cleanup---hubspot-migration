table NEW
	lineageTag: d2b6f310-936c-42e4-8a4b-334f183f23b5

	measure 'Total Contacts' = COUNTROWS(FileB_Scheduler_Contacts) + COUNTROWS(FileD_Archive)
		formatString: 0
		lineageTag: 6ced636e-4b95-4182-a5d6-eb045a420d82

	measure 'LIVE Contacts' =
			
			CALCULATE(
			    COUNTROWS(FileB_Scheduler_Contacts),
			    FileB_Scheduler_Contacts[data_status] = "LIVE"
			)
		formatString: 0
		lineageTag: c95700e2-7f60-4f93-a3f4-278abb1a761e

	measure 'ARCHIVE Contacts' = COUNTROWS(FileD_Archive)
		formatString: 0
		lineageTag: 5c599d4a-9f3d-408f-aaee-5433ce195544

	measure 'LIVE %' = DIVIDE([LIVE Contacts],[Total Contacts],0)
		lineageTag: 8a1a8384-6b82-4afa-aec7-83c516c58e7c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Contacts by Year' =
			
			CALCULATE(
			    COUNTROWS(FileB_Scheduler_Contacts) +
			    COUNTROWS(FileD_Archive),
			    USERELATIONSHIP(
			        FileB_Scheduler_Contacts[last_appointment_date],
			        DimDate[Date]
			    )
			)
		formatString: 0
		lineageTag: f62b765a-9870-4003-bd70-17b2f82d0f80

	measure 'Total Revenue' = SUM(FileB_Scheduler_Contacts[lifetime_spend])
		lineageTag: 378184a4-2838-4203-b69d-6bd0f4ce93ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Revenue' =
			DIVIDE(SUM(FileB_Scheduler_Contacts[lifetime_spend]),
			    COUNTROWS(FileB_Scheduler_Contacts), 0)
		lineageTag: c7fada12-4a4a-45b2-a365-c3c4beb7f65f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rev LIVE' = ```
			CALCULATE(SUM(FileB_Scheduler_Contacts[lifetime_spend]),
			    FileB_Scheduler_Contacts[data_status]="LIVE")
			
			```
		lineageTag: 2761597f-459a-4928-a92e-571eaf128467

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rev ARCHIVE' =
			
			CALCULATE(
			    SUM(FileD_Archive[archive_total_spent]),
			    FileD_Archive[daysmart_status] = "ARCHIVE"
			)
		lineageTag: 85046bf6-7c06-4fc4-9af6-46dbe5c28622

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Service Revenue' = ```
			CALCULATE(SUM(FileC_Scheduler_ApptHistory[amount_usd]), 
			    ALLEXCEPT(FileC_Scheduler_ApptHistory, FileC_Scheduler_ApptHistory[service]))
			```
		lineageTag: 0770215c-7603-4964-b7c5-fcb2db346fb5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly Revenue' = ```
			
			    CALCULATE(SUM(FileC_Scheduler_ApptHistory[amount_usd]),
			     DATESMTD(FileC_Scheduler_ApptHistory[appointment_date])
			     )
			```
		lineageTag: 5635ad17-37b0-477c-aa8c-44004092663a

